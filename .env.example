DATABASE_URL="postgresql://user:password@localhost:5432/gci?schema=public"

# ── Cron ──────────────────────────────────────────────────────────
# Shared secret for the Cron endpoints (/api/v1/cron/*).
# In Vercel, set this as a Project Environment Variable — Vercel Cron will
# send `Authorization: Bearer <CRON_SECRET>` automatically.
# Leaving it blank allows local development (NODE_ENV !== "production").
CRON_SECRET=""

# ── Admin ─────────────────────────────────────────────────────────
# HTTP Basic Auth for /admin/* routes.
# ADMIN_PASSWORD は必須。未設定の場合、本番では 503 を返す。
# ADMIN_USER は省略時 "admin"。
ADMIN_USER="admin"
ADMIN_PASSWORD=""

# ── SEO / OG ──────────────────────────────────────────────────────
# 本番 URL（sitemap / OG 画像取得で使用）
NEXT_PUBLIC_BASE_URL="https://globalcardindex.com"

# ── X (Twitter) 自動投稿 ──────────────────────────────────────────
# X Developer Portal → プロジェクト → App → Keys and Tokens で取得。
# 「Read and Write」権限の OAuth 1.0a User Context が必要。
#
# 取得手順:
#   1. https://developer.x.com でアプリ作成（Free Tier 可）
#   2. App Settings → User authentication settings → Read and Write
#   3. Keys and Tokens → Consumer Keys (API Key / Secret)
#   4. Keys and Tokens → Access Token and Secret (アカウント所有者のもの)
TWITTER_API_KEY=""
TWITTER_API_SECRET=""
TWITTER_ACCESS_TOKEN=""
TWITTER_ACCESS_SECRET=""

# ── Discord Webhook ────────────────────────────────────────────────
# Discord サーバー設定 → 連携サービス → Webhook → 新しい Webhook で取得。
# 形式: https://discord.com/api/webhooks/{webhook.id}/{webhook.token}
#
# 取得手順:
#   1. Discord サーバーの「チャンネルの編集」→「連携サービス」→「Webhook」
#   2. 「新しい Webhook」を作成（名前: "GCI Market Bot" など）
#   3. 「Webhook URLをコピー」
DISCORD_WEBHOOK_URL=""

# ── Discord Market Alerts (Week 20) ──────────────────────────────
# 3 つのチャンネル用 Webhook — それぞれ省略可（未設定 → そのチャンネルへの送信をスキップ）
#
# DISCORD_WEBHOOK_ALERTS → #market-alerts  大幅変動カード（±10%以上）を投稿
# DISCORD_WEBHOOK_RISING → #rising-cards   上昇カードのみ投稿
# DISCORD_WEBHOOK_LOG    → #collector-log  毎日の recalc サマリーを投稿
#
# 取得手順: チャンネルの編集 → 連携サービス → Webhook → 新しい Webhook → URL をコピー
DISCORD_WEBHOOK_ALERTS=""
DISCORD_WEBHOOK_RISING=""
DISCORD_WEBHOOK_LOG=""

# ── Plausible Analytics (Week 20) ────────────────────────────────
# apps/web の公開サイトに Plausible Analytics スクリプトを埋め込む。
# https://plausible.io でサイトを登録後に表示されるドメイン名を設定。
# 未設定の場合はスクリプトが挿入されない（dev 環境での誤計測防止）。
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""

# ── Discord Invite (Week 21) ──────────────────────────────────────
# /beta ページに表示する Discord サーバーの招待 URL。
# Discord サーバー設定 → 招待リンク → 有効期限なしで生成。
NEXT_PUBLIC_DISCORD_INVITE=""

# ── Resend (Newsletter) ───────────────────────────────────────────
# https://resend.com でアカウント作成 → API Keys → Create API Key
# 送信元ドメインは Resend の「Domains」で検証が必要。
#
# 取得手順:
#   1. https://resend.com でサインアップ
#   2. Domains → Add Domain → DNS 設定（MX / SPF / DKIM）
#   3. API Keys → Create API Key（送信権限付き）
#   4. RESEND_FROM_EMAIL は "表示名 <アドレス>" 形式で設定
RESEND_API_KEY=""
RESEND_FROM_EMAIL="GCI <noreply@globalcardindex.com>"

# Resend Webhook 署名シークレット
# Resend ダッシュボード → Webhooks → エンドポイント → Signing Secret
# 形式: "whsec_<base64>"
RESEND_WEBHOOK_SECRET=""

# ── DB バックアップアラート ───────────────────────────────────────
# /api/v1/cron/backup が行数の異常を検知した場合に通知するメールアドレス。
# 未設定の場合は検知はしても通知しない（BackupLog には記録される）。
BACKUP_ALERT_EMAIL=""

# ── Observability (Week 13) ───────────────────────────────────────
# /api/v1/cron/health が cron の失敗・遅延を検知した場合に Discord へ通知する。
# DISCORD_WEBHOOK_URL（上記）を共有。未設定の場合はログのみ記録（通知なし）。
# GitHub Actions の backup.yml も同 URL にエラー通知を送る（Actionsシークレット側にも設定が必要）。
#
# 公開ヘルスチェックエンドポイント: https://gci-index.com/api/v1/health
# UptimeRobot 等から HTTP 監視すること。キーワード: "ok":true
#
# アプリバージョン（任意）— /api/v1/health のレスポンスに含まれる
NEXT_PUBLIC_APP_VERSION="1.0.0"

# ── Newsletter 実配信フラグ ───────────────────────────────────────
# "true" にすると daily-newsletter cron が実際にメールを送信する。
# デプロイなしで Vercel 環境変数から ON/OFF できる。
#
# 有効化前のチェックリスト:
#   1. ?dry=1 で動作確認済み
#   2. ?test=your@email.com で受信・List-Unsubscribe 確認済み
#   3. /admin/newsletter で RunLog 確認済み
#   4. Resend Webhook (bounce/complaint) 設定済み
NEWSLETTER_SEND_ENABLED="false"

# ── 市場アラートメール（watchlist-alerts cron）─────────────────────────
# 15%以上の変動を検知した日にアクティブ購読者へアラートを送信する
# ?dry=1 で確認後、ALERT_SEND_ENABLED="true" に変更して有効化
ALERT_SEND_ENABLED="false"
ALERT_THRESHOLD_PCT="15"       # 変動率しきい値（デフォルト 15%）
ALERT_LOOKBACK_HOURS="4"       # recalc 後に何時間以内の指数値を対象にするか

# ── 週次まとめメール（weekly-recap cron）──────────────────────────────
# 毎週月曜に急騰・急落・新規カード・人気リクエストをまとめて配信
WEEKLY_SEND_ENABLED="false"

# ── Auth.js v5 (Week 23 — ユーザー認証) ──────────────────────────────
# Magic-link 認証（Resend 経由）を使用。
#
# AUTH_SECRET:
#   openssl rand -base64 32  で生成。
#   Vercel にデプロイする場合は Environment Variables に設定。
AUTH_SECRET=""

# AUTH_RESEND_KEY:
#   Auth.js が magic-link メールを送信するための Resend API キー。
#   RESEND_API_KEY と同じ値でも可（別スコープに分けることも推奨）。
AUTH_RESEND_KEY=""

# AUTH_URL:
#   本番環境での公開 URL。Vercel では自動設定されるため省略可。
#   ローカル開発時は http://localhost:3000 を設定。
#   例: AUTH_URL="https://globalcardindex.com"
# AUTH_URL=""
