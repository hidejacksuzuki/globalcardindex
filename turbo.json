{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "DATABASE_URL",
        "AUTH_SECRET",
        "AUTH_RESEND_KEY",
        "RESEND_API_KEY",
        "RESEND_FROM_EMAIL",
        "CRON_SECRET",
        "ADMIN_PASSWORD",
        "ADMIN_USER",
        "NEXT_PUBLIC_BASE_URL",
        "NEXT_PUBLIC_PLAUSIBLE_DOMAIN",
        "NEXT_PUBLIC_DISCORD_INVITE",
        "NEXT_PUBLIC_APP_VERSION"
      ]
    },
    "dev": {
      "cache":      false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    },
    "db:studio": {
      "cache":      false,
      "persistent": true
    }
  }
}
