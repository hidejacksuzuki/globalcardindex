// ============================================================
// Global Card Index — Prisma Schema
// DB: PostgreSQL (Supabase)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") // Supabase connection pooling 用
}

// ============================================================
// ENUMS
// ============================================================

enum Condition {
  NM // Near Mint
  EX // Excellent
  VG // Very Good
  G  // Good
  PO // Poor
}

enum PriceSource {
  MANUAL       // 手動入力
  CSV_IMPORT   // CSVインポート
  SCRAPER      // 自動スクレイピング (Python worker)
  MARKET_API   // 外部マーケットAPI
}

enum IndexMethod {
  SIMPLE_AVERAGE      // 単純平均
  WEIGHTED_AVERAGE    // 加重平均
  MARKET_CAP          // 時価総額加重
}

// ============================================================
// GAMES & SETS（カードゲーム種別・拡張パック）
// ============================================================

model Game {
  id        String   @id @default(cuid())
  name      String   @unique // "Pokémon TCG", "Magic: The Gathering", "One Piece TCG"
  slug      String   @unique // "pokemon", "mtg", "onepiece"
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sets         Set[]
  cards        Card[]
  marketSources MarketSource[]
  cardIndices  CardIndex[]
}

model Set {
  id         String    @id @default(cuid())
  gameId     String
  name       String                          // "スカーレット&バイオレット", "Bloomburrow"
  code       String                          // "SV1", "BLB"
  releasedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  game  Game   @relation(fields: [gameId], references: [id], onDelete: Restrict)
  cards Card[]

  @@unique([gameId, code])
  @@index([gameId])
}

// ============================================================
// CARDS（カードマスター）
// ============================================================

model Card {
  id         String   @id @default(cuid())
  gameId     String
  setId      String?
  name       String                // カード名
  nameEn     String?               // 英語名
  cardNumber String?               // "001/165"
  rarity     String?               // "RR", "SAR", "Mythic Rare"
  imageUrl   String?               // カード画像URL
  foil       Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  game            Game             @relation(fields: [gameId], references: [id], onDelete: Restrict)
  set             Set?             @relation(fields: [setId], references: [id], onDelete: SetNull)
  cardPrices      CardPrice[]
  indexComponents IndexComponent[]

  @@index([gameId])
  @@index([setId])
  @@index([name])
}

// ============================================================
// CARD_PRICES（価格履歴）
// ============================================================

model CardPrice {
  id         String      @id @default(cuid())
  cardId     String
  price      Decimal     @db.Decimal(12, 2)
  currency   String      @default("JPY")
  condition  Condition   @default(NM)
  source     PriceSource @default(MANUAL)
  sourceId   String?     // market_sources.id（どのソースから取得したか）
  recordedAt DateTime    @default(now())  // 価格が観測された日時
  createdAt  DateTime    @default(now())

  card         Card          @relation(fields: [cardId], references: [id], onDelete: Cascade)
  marketSource MarketSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@index([cardId, recordedAt(sort: Desc)])
  @@index([recordedAt])
  @@index([sourceId])
}

// ============================================================
// MARKET_SOURCES（価格データ取得元）
// ============================================================

model MarketSource {
  id          String   @id @default(cuid())
  gameId      String?                        // null = 全ゲーム対応
  name        String   @unique              // "TCGPlayer", "Mercari JP", "Amazon JP"
  slug        String   @unique              // "tcgplayer", "mercari-jp", "amazon-jp"
  baseUrl     String?
  isActive    Boolean  @default(true)
  lastFetchAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  game       Game?       @relation(fields: [gameId], references: [id], onDelete: SetNull)
  cardPrices CardPrice[]

  @@index([gameId])
  @@index([isActive])
}

// ============================================================
// CARD_INDICES（市場インデックス）
// ============================================================

model CardIndex {
  id          String      @id @default(cuid())
  gameId      String?                        // null = 全ゲーム横断インデックス
  name        String      @unique            // "Global Card Index 100", "Pokémon Top 50"
  slug        String      @unique            // "gci-100", "pokemon-top-50"
  description String?
  method      IndexMethod @default(SIMPLE_AVERAGE)
  baseValue   Decimal     @db.Decimal(12, 4) @default(1000) // 基準値（例: 1000）
  baseDate    DateTime?                      // 基準日
  isPublished Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  game       Game?            @relation(fields: [gameId], references: [id], onDelete: SetNull)
  snapshots  IndexSnapshot[]
  components IndexComponent[]

  @@index([gameId])
  @@index([isPublished])
}

// インデックスの構成銘柄（どのカードが何の重みで入るか）
model IndexComponent {
  id        String  @id @default(cuid())
  indexId   String
  cardId    String
  weight    Decimal @db.Decimal(8, 6) @default(1.0) // 加重平均用ウェイト

  index CardIndex @relation(fields: [indexId], references: [id], onDelete: Cascade)
  card  Card      @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([indexId, cardId])
  @@index([indexId])
}

// インデックスの時系列スナップショット（チャート表示用）
model IndexSnapshot {
  id           String   @id @default(cuid())
  indexId      String
  value        Decimal  @db.Decimal(12, 4) // インデックス値
  cardCount    Int                          // 算出時の構成カード数
  calculatedAt DateTime @default(now())

  index CardIndex @relation(fields: [indexId], references: [id], onDelete: Cascade)

  @@index([indexId, calculatedAt(sort: Desc)])
}
