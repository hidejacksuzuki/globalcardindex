{
  "name": "gci-monorepo",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev  --filter=web",
    "dev:data": "turbo run dev  --filter=data",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "db:generate": "turbo run db:generate --filter=@gci/db",
    "db:migrate":  "turbo run db:migrate  --filter=@gci/db",
    "db:studio":   "turbo run db:studio   --filter=@gci/db",
    "db:seed":           "tsx scripts/seed.ts",
    "db:seed:dry":       "tsx scripts/seed.ts --dry",
    "db:seed-cards":     "tsx scripts/seed-cards.ts",
    "db:seed-cards:dry": "tsx scripts/seed-cards.ts --dry"
  },
  "devDependencies": {
    "turbo":      "^2.3.0",
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@prisma/client", "@prisma/engines", "prisma"]
  }
}